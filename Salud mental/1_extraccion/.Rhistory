library(glue)
library(ineapir)
library(purrr)
library(readxl)
suppressPackageStartupMessages({
require_packages(c("glue", "ineapir", "purrr", "readxl"))
library(glue)
library(ineapir)
library(purrr)
library(readxl)
})
run_extraccion <- function(cfg) {
log_event("INFO", "Iniciando extracción")
assert_file_exists(cfg$sanidad_xls, "fuente Ministerio de Sanidad")
m_sanidad <- readxl::read_excel(cfg$sanidad_xls)
assert_required_columns(
m_sanidad,
c("indicador", "nombre de indicador", "año", "ccaa", "sexo", "nse", "valor"),
"m_sanidad"
)
log_event("INFO", "Descargando suicidios desde la API del INE (tabla 46688)")
suicidios <- ineapir::get_data_table(idTable = 46688, tip = "A", unnest = TRUE)
assert_required_columns(suicidios, c("Nombre", "NombrePeriodo", "Valor"), "suicidios")
outputs <- list(
m_sanidad = m_sanidad,
suicidios = suicidios
)
save_named_rds(outputs, cfg$extraction_dir)
log_event("OK", glue("Extracción completada: {length(outputs)} datasets"))
invisible(outputs)
}
View(run_extraccion)
