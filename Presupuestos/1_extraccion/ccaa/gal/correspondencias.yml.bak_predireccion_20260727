  vivienda:
    codigos:
    - '451*'   # rehabilitación / acceso á vivenda
    - '521*'   # urbanismo
    keywords:
    - vivenda
    - vivienda
    - urbanismo
    - cons. vivenda
  empleo:
    codigos:
    - '321*'   # dirección e servizos xerais de emprego
    - '322*'   # mellora da empregabilidade / fomento do emprego
    - '323*'   # formación profesional para o emprego
    - '324*'   # relacións laborais / economía social
    keywords:
    - emprego
    - empleo
    - empregabilidade
    - economia social
    - cons. emprego
  idi:
    codigos:
    - 561A     # plan galego de I+D+i
    - '571*'   # fomento da sociedade da información
    keywords:
    - investigacion
    - investigación
    - innovacion
