# gal/correspondencias.yml — Galicia.
# OJO: la clasificación funcional gallega pone SANIDAD en el grupo 41x y los
# SERVIZOS SOCIAIS en el 31x (al revés que Cantabria/genérico). Los `codigos` se
# derivan del catálogo real de programas (PROGR_I/II) — ver logs/progreso.md 2026-06-30.
# Los `keywords` siguen sirviendo a la rama CSV (datos abertos), que usa códigos
# sintéticos consellería×grupo y no casa con estos prefijos de programa.
# Prefijos de programa llevan '*' (el helper sólo hace prefix-match si termina en '*');
# los códigos de 4 caracteres son match exacto (gana sobre el prefijo).
conceptos:
  sanidad:
    codigos:
    - '411*'   # dirección e servizos xerais de sanidade (transferencia SERGAS)
    - '412*'   # atención hospitalaria / primaria
    - '413*'   # protección e promoción da saúde pública
    - '414*'   # formación de graduados e posgraduados
    - 561C     # investigación sanitaria
    keywords:
    - sanidade
    - atencion primaria
    - atencion hospitalaria
    - saude publica
    - sanitaria
    - cons. sanidade
  educacion:
    codigos:
    - '421*'
    - '422*'
    - '423*'
    - 561B     # investigación universitaria
    keywords:
    - educa          # rama CSV: consellería "CULTURA, EDUCA. E UNIV." (abreviado)
    - educacion
    - educación
    - ensino
    - ensinanza
    - universidade
    - cons. educacion
    - cons. educación
  soberania:
    codigos:
    - '711*'   # medio rural
    - '712*'
    - '713*'
    - '721*'   # políticas pesqueiras
    - '722*'
    - '723*'
    - '551*'   # infraestruturas / forestal no medio rural
    - '514*'   # infraestruturas pesqueiras
    keywords:
    - medio rural
    - rural
    - pesqueira
    - pesqueiro
    - agraria
    - agroalimentaria
    - mar
    - cons. mar
    - cons. medio rural
  direccion:
    codigos:
    - '111*'   # alta dirección
    - '121*'
    - '122*'
    - '123*'
    - '124*'
    - '131*'   # administración de xustiza
    - '141*'   # administración local
    - '161*'   # eleccións
    - '212*'   # protección civil
    - '581*'   # estatística
    - '611*'   # facenda
    - '612*'
    - '621*'
    - '811*'   # transferencias a entidades locais
    - '911*'   # amortización e gastos financeiros da débeda
