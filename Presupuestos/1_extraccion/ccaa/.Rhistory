gt::cols_label(.list = stats::setNames(as.list(yrs), val_cols)) %>%
gt::sub_missing(missing_text = "—")
# Aplicar estilo de imputado: cursiva + color gris medio donde imp_mat es TRUE.
for (yr in yrs) {
col_name <- paste0("valor_", yr)
rows_imp <- which(imp_mat[[as.character(yr)]] %in% TRUE)
if (length(rows_imp) > 0L) {
tbl <- tbl %>% gt::tab_style(
style    = gt::cell_text(style = "italic", color = "#6e6e6e"),
locations = gt::cells_body(columns = dplyr::all_of(col_name),
rows = rows_imp)
)
}
}
gt::gtsave(tbl, output_path)
invisible(output_path)
}
# =============================================================================
# Tabla resumen estadístico por CCAA
# =============================================================================
#' Para cada CCAA: media, sd, tasa de variación, z-score nacional, pendiente.
#' La tasa de variación se calcula entre el primer y último año con observación
#' real (no imputada) de la CCAA, dentro del rango 2015-2024 si hay datos
#' completos; si no, en el rango disponible.
tabla_resumen <- function(serie, var_spec, output_csv, output_html) {
obs <- serie %>% dplyr::filter(!.data$imputado)
if (nrow(obs) == 0L) return(invisible(NULL))
pendiente <- function(periodo, valor) {
if (length(unique(periodo[!is.na(valor)])) < 3L) return(NA_real_)
fit <- tryCatch(stats::lm(valor ~ periodo), error = function(e) NULL)
if (is.null(fit)) return(NA_real_)
unname(stats::coef(fit)["periodo"])
}
tasa_var <- function(periodo, valor) {
df <- data.frame(p = periodo, v = valor)
df <- df[!is.na(df$v), ]
if (nrow(df) < 2L) return(NA_real_)
primero <- df$v[which.min(df$p)]
ultimo  <- df$v[which.max(df$p)]
if (primero == 0 || !is.finite(primero)) return(NA_real_)
(ultimo / primero - 1) * 100
}
media_nacional <- obs %>%
dplyr::filter(.data$ccaa == "Media Estatal") %>%
dplyr::summarise(media = mean(.data$valor, na.rm = TRUE),
sd    = stats::sd(.data$valor, na.rm = TRUE)) %>%
as.list()
por_ccaa <- obs %>%
dplyr::filter(.data$ccaa != "Media Estatal") %>%
dplyr::group_by(.data$ccaa) %>%
dplyr::summarise(
n_obs       = dplyr::n(),
media       = mean(.data$valor, na.rm = TRUE),
sd          = stats::sd(.data$valor, na.rm = TRUE),
tasa_var_pct = tasa_var(.data$periodo, .data$valor),
pendiente_anual = pendiente(.data$periodo, .data$valor),
.groups = "drop"
) %>%
dplyr::mutate(
z_score_nacional = if (is.finite(media_nacional$sd) && media_nacional$sd > 0)
(media - media_nacional$media) / media_nacional$sd
else NA_real_
) %>%
dplyr::arrange(dplyr::desc(.data$media))
utils::write.csv(por_ccaa, output_csv, row.names = FALSE, fileEncoding = "UTF-8")
tbl <- por_ccaa %>%
gt::gt(rowname_col = "ccaa") %>%
gt::tab_header(title = glue("Resumen por CCAA · {var_spec$label}")) %>%
gt::fmt_number(columns = c("media","sd","pendiente_anual"),
decimals = var_spec$decimals, sep_mark = ".", dec_mark = ",") %>%
gt::fmt_number(columns = c("tasa_var_pct","z_score_nacional"),
decimals = 2, sep_mark = ".", dec_mark = ",") %>%
gt::cols_label(
n_obs            = "n",
media            = "Media",
sd               = "SD",
tasa_var_pct     = "Δ% periodo",
pendiente_anual  = "Pendiente / año",
z_score_nacional = "z vs. nacional"
)
gt::gtsave(tbl, output_html)
invisible(por_ccaa)
}
# =============================================================================
# Small multiples (facet_wrap por CCAA)
# =============================================================================
small_multiples <- function(serie, var_spec, output_path) {
# Trazado: línea sólida para observados, segmento discontinuo conectando
# último observado con punto imputado, banda 95% en imputado.
serie_plot <- serie %>%
dplyr::filter(.data$ccaa != "Media Estatal") %>%
dplyr::arrange(.data$ccaa, .data$periodo)
obs_serie <- serie_plot %>% dplyr::filter(!.data$imputado)
imp_serie <- serie_plot %>% dplyr::filter(.data$imputado)
# Para conectar visualmente la última observación de cada CCAA con el punto
# imputado, construimos un set "puente" que duplica el último observado
# con la flag imputado=TRUE.
ultimo_obs <- obs_serie %>%
dplyr::group_by(.data$ccaa) %>%
dplyr::slice_max(.data$periodo, n = 1) %>%
dplyr::ungroup()
puente <- dplyr::bind_rows(ultimo_obs, imp_serie) %>%
dplyr::arrange(.data$ccaa, .data$periodo)
p <- ggplot2::ggplot() +
# Observados: línea sólida
ggplot2::geom_line(
data = obs_serie,
mapping = ggplot2::aes(.data$periodo, .data$valor),
color = "#08306B", linewidth = 0.7
) +
ggplot2::geom_point(
data = obs_serie,
mapping = ggplot2::aes(.data$periodo, .data$valor),
color = "#08306B", size = 0.9
) +
# Imputados: línea discontinua puenteando observado→imputado
ggplot2::geom_line(
data = puente,
mapping = ggplot2::aes(.data$periodo, .data$valor),
color = "#D62728", linewidth = 0.6, linetype = "dashed"
) +
ggplot2::geom_point(
data = imp_serie,
mapping = ggplot2::aes(.data$periodo, .data$valor),
color = "#D62728", size = 1.4
) +
# Banda 95% del bagging (solo imputado)
ggplot2::geom_errorbar(
data = imp_serie,
mapping = ggplot2::aes(x = .data$periodo, ymin = .data$li_95, ymax = .data$ls_95),
color = "#D62728", width = 0.4, alpha = 0.6
) +
ggplot2::facet_wrap(~ ccaa, scales = "free_y", ncol = 4) +
ggplot2::labs(
title    = var_spec$label,
subtitle = "Líneas sólidas: observado · líneas discontinuas y barras rojas: imputado 2025 (bagged ETS, IC 95%)",
x = NULL, y = var_spec$unidad
) +
ggplot2::scale_x_continuous(breaks = scales::pretty_breaks(n = 4)) +
ggplot2::scale_y_continuous(labels = scales::label_number(big.mark = ".", decimal.mark = ",")) +
ggplot2::theme_minimal(base_size = 9) +
ggplot2::theme(
strip.text  = ggplot2::element_text(size = 8, face = "bold"),
plot.title  = ggplot2::element_text(face = "bold", size = 12),
plot.subtitle = ggplot2::element_text(size = 9, color = "grey30"),
axis.text   = ggplot2::element_text(size = 7),
panel.grid.minor = ggplot2::element_blank()
)
ggplot2::ggsave(output_path, p, width = 12, height = 8, dpi = 130, bg = "white")
invisible(output_path)
}
# =============================================================================
# Orquestador
# =============================================================================
run_anexos_v2 <- function(cfg) {
log_event("INFO", "Iniciando anexos v2 (variables complementarias)")
ensure_dir(cfg$analisis_output)
fin <- readRDS(file.path(cfg$transform_dir, "financiacion.rds"))
det <- readRDS(file.path(cfg$transform_dir, "determinantes.rds"))
central <- readRDS(file.path(cfg$transform_dir, "imputaciones_centrales.rds"))
tablas <- list(financiacion = fin, determinantes = det)
for (var_name in names(.AV2_VARS)) {
spec <- .AV2_VARS[[var_name]]
log_event("INFO", glue("· {var_name}: construyendo serie + outputs"))
serie <- build_serie(var_name, tablas, central)
if (nrow(serie) == 0L) {
log_event("WARN", glue("Anexo {var_name}: serie vacía, se omite"))
next
}
safe_step(tabla_evolutiva(
serie, spec,
file.path(cfg$analisis_output, glue("anexo_v2_{var_name}_evolutiva.html"))
), label = glue("anexo {var_name} evolutiva"), default = NULL)
safe_step(tabla_resumen(
serie, spec,
file.path(cfg$analisis_output, glue("anexo_v2_{var_name}_resumen.csv")),
file.path(cfg$analisis_output, glue("anexo_v2_{var_name}_resumen.html"))
), label = glue("anexo {var_name} resumen"), default = NULL)
safe_step(small_multiples(
serie, spec,
file.path(cfg$analisis_output, glue("anexo_v2_{var_name}_small_multiples.png"))
), label = glue("anexo {var_name} small multiples"), default = NULL)
}
log_event("OK", glue("Anexos v2 completados · {length(.AV2_VARS)} variables procesadas"))
invisible(NULL)
}
# =============================================================================
# CLI
# =============================================================================
if (sys.nframe() == 0L) {
this_script <- sys.frame(1)$ofile %||%
sub("^--file=", "", grep("--file=", commandArgs(), value = TRUE)[1])
this_dir <- if (!is.null(this_script) && nzchar(this_script))
dirname(normalizePath(this_script, winslash = "/", mustWork = TRUE)) else getwd()
project_root <- dirname(this_dir)
source(file.path(project_root, "R", "ccaa_dictionary.R"))
source(file.path(project_root, "R", "pipeline_utils.R"))
cfg <- build_pipeline_config(project_root, list())
run_anexos_v2(cfg)
}
# =============================================================================
# 99b_anexos_variables_complementarias.R — Anexos de las 3 variables nuevas
# Microinforme "2. Prevención" · ODESOCAN · iteración 2026-05
#
# Para cada una de las variables incorporadas en mayo 2026:
#   · pib_pc_eur               (INE op. 30679, XLSX Tabla_2)
#   · indice_envejecimiento    (INE 56940, derivado del censo trimestral)
#   · gasto_sanitario_pc_eur   (PDF Presupuestos Iniciales / censo)
#
# Genera tres outputs por variable:
#   1. Tabla evolutiva CCAA × año (gt::gt → HTML), con celdas imputadas
#      en cursiva y color tenue.
#   2. Tabla resumen estadístico por CCAA: media, sd, tasa de variación
#      del periodo común, z-score nacional, pendiente lineal anual.
#   3. Small multiples ggplot (facet_wrap por CCAA) con línea sólida para
#      observados y discontinua para imputados; banda 95% para imputados
#      (ribbon entre li_95 y ls_95 de imputaciones_centrales).
#
# Inputs:
#   2_transformacion/financiacion.rds, determinantes.rds
#   2_transformacion/imputaciones_centrales.rds (para banda 95% y flag imputado)
#
# Outputs (5_análisis/output/):
#   anexo_v2_<var>_evolutiva.html
#   anexo_v2_<var>_resumen.html
#   anexo_v2_<var>_resumen.csv
#   anexo_v2_<var>_small_multiples.png
# =============================================================================
suppressPackageStartupMessages({
require_packages(c(
"dplyr","tibble","tidyr","purrr","glue","ggplot2","scales","stringr","gt"
))
library(dplyr); library(tibble); library(tidyr); library(purrr); library(glue)
library(ggplot2)
})
# Mapa de variables → tabla origen + columna + etiqueta + decimales para gt
.AV2_VARS <- list(
pib_pc_eur = list(
tabla    = "determinantes",
col      = "pib_pc_eur",
label    = "PIB per cápita (€)",
unidad   = "€/hab.",
decimals = 0
),
indice_envejecimiento = list(
tabla    = "determinantes",
col      = "indice_envejecimiento",
label    = "Índice de envejecimiento",
unidad   = "(≥65/0-14)·100",
decimals = 1
),
gasto_sanitario_pc_eur = list(
tabla    = "financiacion",
col      = "gasto_sanitario_pc_eur",
label    = "Gasto sanitario público pc (€)",
unidad   = "€/hab.",
decimals = 0
)
)
# =============================================================================
# Construcción de series largas
# =============================================================================
#' Devuelve un tibble largo (ccaa, periodo, valor, imputado) para una variable.
#' Une las observaciones reales (de la tabla origen) con las predicciones
#' centrales 2025 (de imputaciones_centrales), marcando imputado=TRUE solo
#' donde no había observación previa para ese (ccaa, periodo).
build_serie <- function(var_name, tablas, central) {
spec <- .AV2_VARS[[var_name]]
obs <- tablas[[spec$tabla]] %>%
dplyr::filter(.data$genero == "total",
.data$ccaa %in% official_ccaa_levels()) %>%
dplyr::select(dplyr::all_of(c("ccaa","periodo", spec$col))) %>%
dplyr::rename(valor = dplyr::all_of(spec$col)) %>%
dplyr::filter(!is.na(.data$valor)) %>%
dplyr::mutate(imputado = FALSE, li_95 = NA_real_, ls_95 = NA_real_)
imp <- central %>%
dplyr::filter(.data$variable == var_name,
.data$ccaa %in% official_ccaa_levels()) %>%
dplyr::select(dplyr::all_of(c("ccaa","periodo","valor","li_95","ls_95"))) %>%
dplyr::mutate(imputado = TRUE)
# Si una celda imputada coincide con una observada, prevalece la observada.
# anti_join elimina del set de imputaciones lo que ya está en obs.
imp <- dplyr::anti_join(imp, obs, by = c("ccaa","periodo"))
dplyr::bind_rows(obs, imp) %>%
dplyr::arrange(.data$ccaa, .data$periodo)
}
# =============================================================================
# Tabla evolutiva (CCAA × año)
# =============================================================================
#' gt con CCAA en filas, años en columnas. Las celdas imputadas se muestran
#' en cursiva con color gris medio para diferenciarlas visualmente.
tabla_evolutiva <- function(serie, var_spec, output_path) {
wide <- serie %>%
dplyr::select("ccaa", "periodo", "valor", "imputado") %>%
tidyr::pivot_wider(names_from = "periodo", values_from = c("valor","imputado"))
# Ordena las columnas: primero ccaa, luego pares (valor_<año>) ordenados.
yrs <- sort(unique(serie$periodo))
val_cols <- paste0("valor_", yrs)
imp_cols <- paste0("imputado_", yrs)
wide <- wide %>% dplyr::select(dplyr::all_of(c("ccaa", val_cols)))
# Construir matriz lógica de imputado para colorear celdas
imp_mat <- serie %>%
dplyr::select("ccaa", "periodo", "imputado") %>%
tidyr::pivot_wider(names_from = "periodo", values_from = "imputado")
tbl <- wide %>%
gt::gt(rowname_col = "ccaa") %>%
gt::tab_header(
title    = var_spec$label,
subtitle = glue("Evolución por CCAA (celdas en cursiva = imputadas)")
) %>%
gt::fmt_number(columns = -1, decimals = var_spec$decimals,
sep_mark = ".", dec_mark = ",") %>%
gt::cols_label(.list = stats::setNames(as.list(yrs), val_cols)) %>%
gt::sub_missing(missing_text = "—")
# Aplicar estilo de imputado: cursiva + color gris medio donde imp_mat es TRUE.
for (yr in yrs) {
col_name <- paste0("valor_", yr)
rows_imp <- which(imp_mat[[as.character(yr)]] %in% TRUE)
if (length(rows_imp) > 0L) {
tbl <- tbl %>% gt::tab_style(
style    = gt::cell_text(style = "italic", color = "#6e6e6e"),
locations = gt::cells_body(columns = dplyr::all_of(col_name),
rows = rows_imp)
)
}
}
gt::gtsave(tbl, output_path)
invisible(output_path)
}
# =============================================================================
# Tabla resumen estadístico por CCAA
# =============================================================================
#' Para cada CCAA: media, sd, tasa de variación, z-score nacional, pendiente.
#' La tasa de variación se calcula entre el primer y último año con observación
#' real (no imputada) de la CCAA, dentro del rango 2015-2024 si hay datos
#' completos; si no, en el rango disponible.
tabla_resumen <- function(serie, var_spec, output_csv, output_html) {
obs <- serie %>% dplyr::filter(!.data$imputado)
if (nrow(obs) == 0L) return(invisible(NULL))
pendiente <- function(periodo, valor) {
if (length(unique(periodo[!is.na(valor)])) < 3L) return(NA_real_)
fit <- tryCatch(stats::lm(valor ~ periodo), error = function(e) NULL)
if (is.null(fit)) return(NA_real_)
unname(stats::coef(fit)["periodo"])
}
tasa_var <- function(periodo, valor) {
df <- data.frame(p = periodo, v = valor)
df <- df[!is.na(df$v), ]
if (nrow(df) < 2L) return(NA_real_)
primero <- df$v[which.min(df$p)]
ultimo  <- df$v[which.max(df$p)]
if (primero == 0 || !is.finite(primero)) return(NA_real_)
(ultimo / primero - 1) * 100
}
media_nacional <- obs %>%
dplyr::filter(.data$ccaa == "Media Estatal") %>%
dplyr::summarise(media = mean(.data$valor, na.rm = TRUE),
sd    = stats::sd(.data$valor, na.rm = TRUE)) %>%
as.list()
por_ccaa <- obs %>%
dplyr::filter(.data$ccaa != "Media Estatal") %>%
dplyr::group_by(.data$ccaa) %>%
dplyr::summarise(
n_obs       = dplyr::n(),
media       = mean(.data$valor, na.rm = TRUE),
sd          = stats::sd(.data$valor, na.rm = TRUE),
tasa_var_pct = tasa_var(.data$periodo, .data$valor),
pendiente_anual = pendiente(.data$periodo, .data$valor),
.groups = "drop"
) %>%
dplyr::mutate(
z_score_nacional = if (is.finite(media_nacional$sd) && media_nacional$sd > 0)
(media - media_nacional$media) / media_nacional$sd
else NA_real_
) %>%
dplyr::arrange(dplyr::desc(.data$media))
utils::write.csv(por_ccaa, output_csv, row.names = FALSE, fileEncoding = "UTF-8")
tbl <- por_ccaa %>%
gt::gt(rowname_col = "ccaa") %>%
gt::tab_header(title = glue("Resumen por CCAA · {var_spec$label}")) %>%
gt::fmt_number(columns = c("media","sd","pendiente_anual"),
decimals = var_spec$decimals, sep_mark = ".", dec_mark = ",") %>%
gt::fmt_number(columns = c("tasa_var_pct","z_score_nacional"),
decimals = 2, sep_mark = ".", dec_mark = ",") %>%
gt::cols_label(
n_obs            = "n",
media            = "Media",
sd               = "SD",
tasa_var_pct     = "Δ% periodo",
pendiente_anual  = "Pendiente / año",
z_score_nacional = "z vs. nacional"
)
gt::gtsave(tbl, output_html)
invisible(por_ccaa)
}
# =============================================================================
# Small multiples (facet_wrap por CCAA)
# =============================================================================
small_multiples <- function(serie, var_spec, output_path) {
# Trazado: línea sólida para observados, segmento discontinuo conectando
# último observado con punto imputado, banda 95% en imputado.
serie_plot <- serie %>%
dplyr::filter(.data$ccaa != "Media Estatal") %>%
dplyr::arrange(.data$ccaa, .data$periodo)
obs_serie <- serie_plot %>% dplyr::filter(!.data$imputado)
imp_serie <- serie_plot %>% dplyr::filter(.data$imputado)
# Para conectar visualmente la última observación de cada CCAA con el punto
# imputado, construimos un set "puente" que duplica el último observado
# con la flag imputado=TRUE.
ultimo_obs <- obs_serie %>%
dplyr::group_by(.data$ccaa) %>%
dplyr::slice_max(.data$periodo, n = 1) %>%
dplyr::ungroup()
puente <- dplyr::bind_rows(ultimo_obs, imp_serie) %>%
dplyr::arrange(.data$ccaa, .data$periodo)
p <- ggplot2::ggplot() +
# Observados: línea sólida
ggplot2::geom_line(
data = obs_serie,
mapping = ggplot2::aes(.data$periodo, .data$valor),
color = "#08306B", linewidth = 0.7
) +
ggplot2::geom_point(
data = obs_serie,
mapping = ggplot2::aes(.data$periodo, .data$valor),
color = "#08306B", size = 0.9
) +
# Imputados: línea discontinua puenteando observado→imputado
ggplot2::geom_line(
data = puente,
mapping = ggplot2::aes(.data$periodo, .data$valor),
color = "#D62728", linewidth = 0.6, linetype = "dashed"
) +
ggplot2::geom_point(
data = imp_serie,
mapping = ggplot2::aes(.data$periodo, .data$valor),
color = "#D62728", size = 1.4
) +
# Banda 95% del bagging (solo imputado)
ggplot2::geom_errorbar(
data = imp_serie,
mapping = ggplot2::aes(x = .data$periodo, ymin = .data$li_95, ymax = .data$ls_95),
color = "#D62728", width = 0.4, alpha = 0.6
) +
ggplot2::facet_wrap(~ ccaa, scales = "free_y", ncol = 4) +
ggplot2::labs(
title    = var_spec$label,
subtitle = "Líneas sólidas: observado · líneas discontinuas y barras rojas: imputado 2025 (bagged ETS, IC 95%)",
x = NULL, y = var_spec$unidad
) +
ggplot2::scale_x_continuous(breaks = scales::pretty_breaks(n = 4)) +
ggplot2::scale_y_continuous(labels = scales::label_number(big.mark = ".", decimal.mark = ",")) +
ggplot2::theme_minimal(base_size = 9) +
ggplot2::theme(
strip.text  = ggplot2::element_text(size = 8, face = "bold"),
plot.title  = ggplot2::element_text(face = "bold", size = 12),
plot.subtitle = ggplot2::element_text(size = 9, color = "grey30"),
axis.text   = ggplot2::element_text(size = 7),
panel.grid.minor = ggplot2::element_blank()
)
ggplot2::ggsave(output_path, p, width = 12, height = 8, dpi = 130, bg = "white")
invisible(output_path)
}
# =============================================================================
# Orquestador
# =============================================================================
run_anexos_v2 <- function(cfg) {
log_event("INFO", "Iniciando anexos v2 (variables complementarias)")
ensure_dir(cfg$analisis_output)
fin <- readRDS(file.path(cfg$transform_dir, "financiacion.rds"))
det <- readRDS(file.path(cfg$transform_dir, "determinantes.rds"))
central <- readRDS(file.path(cfg$transform_dir, "imputaciones_centrales.rds"))
tablas <- list(financiacion = fin, determinantes = det)
for (var_name in names(.AV2_VARS)) {
spec <- .AV2_VARS[[var_name]]
log_event("INFO", glue("· {var_name}: construyendo serie + outputs"))
serie <- build_serie(var_name, tablas, central)
if (nrow(serie) == 0L) {
log_event("WARN", glue("Anexo {var_name}: serie vacía, se omite"))
next
}
safe_step(tabla_evolutiva(
serie, spec,
file.path(cfg$analisis_output, glue("anexo_v2_{var_name}_evolutiva.html"))
), label = glue("anexo {var_name} evolutiva"), default = NULL)
safe_step(tabla_resumen(
serie, spec,
file.path(cfg$analisis_output, glue("anexo_v2_{var_name}_resumen.csv")),
file.path(cfg$analisis_output, glue("anexo_v2_{var_name}_resumen.html"))
), label = glue("anexo {var_name} resumen"), default = NULL)
safe_step(small_multiples(
serie, spec,
file.path(cfg$analisis_output, glue("anexo_v2_{var_name}_small_multiples.png"))
), label = glue("anexo {var_name} small multiples"), default = NULL)
}
log_event("OK", glue("Anexos v2 completados · {length(.AV2_VARS)} variables procesadas"))
invisible(NULL)
}
# =============================================================================
# CLI
# =============================================================================
if (sys.nframe() == 0L) {
this_script <- sys.frame(1)$ofile %||%
sub("^--file=", "", grep("--file=", commandArgs(), value = TRUE)[1])
this_dir <- if (!is.null(this_script) && nzchar(this_script))
dirname(normalizePath(this_script, winslash = "/", mustWork = TRUE)) else getwd()
