conceptos:
  sanidad:
    # 2026-07-01: '4131' "Protección y promoción de la salud" RETIRADO — es la
    # transferencia interna del Departamento (sec 16) al Servicio Aragonés de Salud
    # (sec 52) y duplicaba la entrega 4121 (~2×, 3247 €/hab vs ~1600). Se excluye en
    # extract.py (_ARA_TRANSFER_SALUD); aquí se quita por coherencia. Sanidad = 4121
    # (SALUD, entrega) + 4111/4132/4134 (Departamento) + 4124 (banco de sangre).
    codigos:
    - '311'
    - '312'
    - '411'
    - '412'
    - '510'
    # 2026-06-05: '4133' (programa "SALUD MENTAL") movido a salud_mental —
    # estaba absorbido por sanidad y ocultaba el concepto canónico propio.
    - '41'
    # FIX 2026-07-02: exactos que la ficha declara sanidad pero el keyword no
    # casaba (van a NULL). NO usar prefijo 41* aquí: reabsorbería 4133 salud_mental.
    - '4124'  # producción componentes sanguíneos (banco de sangre)
    - '4132'  # servicios de atención al usuario
    keywords:
    - sanidad
    - salud publica
    - servicio canario salud
    - servicio andaluz salud
    - atencion primaria
    - atencion especializada
    - sanitaria
    - osasun
    - salud
