# ext/correspondencias.yml — Extremadura.
# Reescrito 2026-06-30 contra el catálogo REAL de programas del Estado de Gastos
# (Tomo II EIG / estado_ing_gasto). El anterior era un template genérico con
# códigos equivocados (p.ej. 313A "Regulación de Producciones" = agricultura, iba
# a salud_mental; turismo=432A cuando Extremadura usa 342A). Estructura funcional:
#   21x sanidad · 22x educación · 23x dependencia · 24x/325 empleo ·
#   252/253 social · 26x vivienda · 27x cultura/deporte · 31x agricultura ·
#   33x idi/industria · 342 turismo · 35x infraestruturas/medio ambiente.
# Prefijos de 3 dígitos llevan '*' (el helper Python sólo hace prefix-match si
# el código termina en '*'); los de 4 caracteres son match exacto.
conceptos:
  sanidad:
    codigos: ['211*', '212*']
    keywords: [sanidad, sanitaria, sanitarias, salud publica, atencion primaria,
               atencion especializada]
  educacion:
    codigos: ['221*', '222*']
    keywords: [educacion, ensenanza, profesorado, universitarias, educativa]
  dependencia:
    codigos: ['231*', '232*']
    keywords: [dependencia, atencion a la dependencia]
  empleo:
    codigos: ['241*', '242*', '325A']
    keywords: [empleo, relaciones laborales, formacion para el empleo]
  igualdad:
    codigos: [253A, 253D]
    keywords: [igualdad de genero, violencia, mujer]
  vivienda:
    codigos: ['261*', '262*']
    keywords: [vivienda, urbanismo, ordenacion del territorio]
  soberania:
    codigos: ['311*', '312*', '313*', '314A', '323C', '353A']
    keywords: [agricultura, agraria, ganaderia, producciones, medio rural,
               agroalimentaria, infraestructuras agrarias]
  idi:
    codigos: [331A, 331B, '332A']
    keywords: [investigacion, desarrollo tecnologico, innovacion,
               tecnologias de la informacion]
  turismo:
    codigos: ['342*']
    keywords: [turismo]
  diversidad:
    # FIX 2026-07-02: añadidos 252A (Infancia y familias, 40->77 M) y 252B
    # (Inclusion social, 76->98 M): el comentario decia "252/253 social" pero
    # solo mapeaba 252C/253B/253C; ~175 M (2024) iban a NULL (> total diversidad).
    codigos: ['252A', '252B', '252C', '253B', '253C', '271*', '272*', '273*', '274*']
    keywords: [cultura, patrimonio, bibliotecas, museos, teatro, deporte,
               deportivas, juventud, emigracion, cooperacion]
  direccion:
    codigos: ['111*', '112*', '113*', '114*', '115*', '116*', '121*', '131*',
              '331C', '800X']
    keywords: [actividad legislativa, presidencia, hacienda, funcion publica,
               endeudamiento, fondo de contingencia, transferencias entre subsectores]
  discapacidad:
    codigos: []
    keywords: [discapacidad, diversidad funcional]
  salud_mental:
    codigos: []
    keywords: [salud mental]
