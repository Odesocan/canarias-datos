        capa: autonomica
        nota: Extraído del ZIP histórico, archivo 'Ley Presupuestos ... 2016 (BOA 22).pdf' — único PDF con datos consolidados en esa carpeta. Raw extraído N8c.
    '2015':
      ingresos_gastos:
        tipo: pdf
