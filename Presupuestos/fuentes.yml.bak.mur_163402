        capa: autonomica
    # 2017/2016/2015: las URLs conocidas son el texto legal del BOC (articulado de la
    # ley), NO el tomo "Estado de Gastos" por programa -> el motor da 0 filas. Pendiente
    # localizar el Tomo de gastos por programa de esos anios en cantabria.es.
    # 2015-2017: el "Anexo de Desarrollo Económico de Gasto por Centros Gestores" SÍ trae
    # el desglose por programa (sin línea TOTAL PROGRAMA; el total = suma de TOTAL CAPÍTULO)
    # -> motor cnt-centros-suma-capitulos, VERDE_PRAGM (83-84 programas, 12 conceptos).
    # La Ley del BOC (solo tabla política, AMARILLO) queda como fallback documentado.
    '2017':
      desarrollo_centros:
        tipo: pdf
        url: https://www.cantabria.es/documents/16870/4625307/Anexo+de+DESARROLLO+ECON%C3%93MICO+DE+GASTO+POR+CENTROS+GESTORES.pdf/f6bf7256-f48c-fd12-a8f3-ba0ea02fbf3b?t=1488439779828
