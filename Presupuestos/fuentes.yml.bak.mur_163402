cnt:
  nombre: Cantabria
  regimen: comun
  portal: https://www.cantabria.es/web/direccion-general-presupuestos
  # Motor cnt-total-programa-suma-servicios: lee el tomo "Estado de Ingresos y Gastos"
  # (tablas PROGRAMA NNNX ... TOTAL PROGRAMA). pdftotext NO lee estos PDF -> usa
  # pdfplumber (lento, ~450 pags). OJO 2026-06-29: el slot 2025 tenia mal la URL del
  # 2026 ("DEFINITIVA") -> corregido. 2015-2017 NO disponibles aun: las URLs conocidas
  # son el TEXTO LEGAL del BOC (articulado de la ley), no el tomo de gastos por programa.
  ejercicios:
    '2026':
      ingresos_gastos:
        tipo: pdf
        url: https://www.cantabria.es/documents/16870/124906248/2-+2%C2%BA+INGRESOS+Y+GASTOS+DEFINITIVA.pdf
