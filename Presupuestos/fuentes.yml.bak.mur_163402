gal:
  nombre: Galicia
  regimen: comun
  portal: https://transparencia.xunta.gal/es/tema/informacion-economica-orzamentaria-e-estatistica/orzamentos
  # DOS fuentes (ver logs/progreso.md 2026-06-30):
  # (1) 2022→ : CSV consolidado de datos abertos (incluye SERGAS y organismos). Cada
  #     ejercicio tiene su PROPIO id de dataset (el id 0665 NO es rolling: sirve siempre
  #     2025). Patrón: .../-/dataset/<ID>/gastos-orzamento-<año>/001/descarga-directa-ficheiro.csv
  #     IDs: 2022=0443, 2023=0562, 2024=0607, 2025=0665, 2026=0690. CSV solo desde 2022.
  # (2) 2015-2021 : PROGR_I/II.PDF "Orzamentos por programas". OJO: NO está consolidado
  #     (suma bruta dobla por transferencias a organismos: gross 2023=20.2B vs 12.85B real).
  #     El extractor aplica "regla C" = sumar TOTAL PROGRAMA solo de bloques de consellería
  #     (excluye bloques de organismo ejecutor). Validado contra el CSV 2022-2024: sesgo
  #     estable ~-5% en sanidad. Da granularidad de programa (11 conceptos) > que el CSV.
  ejercicios:
    '2026':
      gastos_orzamento:
        tipo: csv
        url: https://abertos.xunta.gal/catalogo/administracion-publica/-/dataset/0690/gastos-orzamento-2026/001/descarga-directa-ficheiro.csv
        capa: autonomica
        nota: CSV consolidado datos abertos (id 0690); 18 filas, 8 conceptos, total 14.70B
    '2025':
      gastos_orzamento:
        tipo: csv
        url: https://abertos.xunta.gal/catalogo/administracion-publica/-/dataset/0665/gastos-orzamento-2025/001/descarga-directa-ficheiro.csv
        capa: autonomica
        nota: CSV de gastos por programa (datos abertos Xunta); raw ya descargado
          N3 — verificado N6 (47 filas, 8 conceptos)
    '2024':
      gastos_orzamento:
        tipo: csv
        url: https://abertos.xunta.gal/catalogo/administracion-publica/-/dataset/0607/gastos-orzamento-2024/001/descarga-directa-ficheiro.csv
        capa: autonomica
        nota: CSV consolidado datos abertos (id 0607); 43 filas, 7 conceptos, total 13.49B
    '2023':
      gastos_orzamento:
        tipo: csv
        url: https://abertos.xunta.gal/catalogo/administracion-publica/-/dataset/0562/gastos-orzamento-2023/001/descarga-directa-ficheiro.csv
        capa: autonomica
        nota: CSV consolidado datos abertos (id 0562); 16 filas, 7 conceptos, total 12.85B (granularidad gruesa)
    '2022':
      gastos_orzamento:
        tipo: csv
        url: https://abertos.xunta.gal/catalogo/administracion-publica/-/dataset/0443/gastos-orzamento-2022/001/descarga-directa-ficheiro.csv
        capa: autonomica
        nota: CSV consolidado datos abertos (id 0443); 16 filas, 9 conceptos, total 11.85B (granularidad gruesa)
    '2021':
      progr:
        tipo: pdf
