ext:
  nombre: Extremadura
  regimen: comun
  portal: https://doe.juntaex.es/
  # FUENTE CANÓNICA = tabla "Resumen por programa" de la LEY DE PRESUPUESTOS (DOE).
  # Da los totales CONSOLIDADOS por programa (1 fila/programa). Motor
  # `ext-doe-resumen-programa`. NO usar el detalle EIG (Tomo II / estado_ing_gasto):
  # es un documento NO consolidado que infravalora educación ~3x al sumar/dedupe el
  # detalle (educación EIG 0.34B vs resumen 1.37B en 2024). Detalle: progreso.md 2026-06-30.
  # 2025 y 2026 son PRÓRROGA de la Ley 2024 (órdenes de prórroga 6-feb-2025 y 16-dic-2025);
  # no hay ley propia → se usa el resumen de 2024. Las URLs ELI resuelven a /pdfs/doe/...
  ejercicios:
    '2026':
      ley_doe:
        tipo: pdf
        url: https://doe.juntaex.es/pdfs/doe/2024/260o/24010001.pdf
        capa: autonomica
        nota: PRÓRROGA de la Ley 1/2024 (orden 16-dic-2025); resumen por programa = 2024
    '2025':
      ley_doe:
        tipo: pdf
        url: https://doe.juntaex.es/pdfs/doe/2024/260o/24010001.pdf
        capa: autonomica
        nota: PRÓRROGA de la Ley 1/2024 (orden 6-feb-2025); resumen por programa = 2024
    '2024':
      ley_doe:
        tipo: pdf
        url: https://doe.juntaex.es/pdfs/doe/2024/260o/24010001.pdf
        capa: autonomica
        nota: Ley 1/2024; resumen por programa — 79 filas, 11 conceptos, total 8.13B
    '2023':
      ley_doe:
        tipo: pdf
        url: https://doe.juntaex.es/pdfs/doe/2022/30e/22010006.pdf
        capa: autonomica
        nota: Ley 6/2022; resumen por programa — 81 filas, total 7.78B
