        url: https://www.cantabria.es/documents/16870/3601314/Anexo+DESARROLLO+ECON%C3%93MICO+DE+GASTO+POR+CENTROS+GESTORES.pdf/54d07522-0f15-46c6-a1d4-ba3fc7b24d54?t=1451904183021
        capa: autonomica
        nota: Suma de TOTAL CAPÍTULO por programa. Carpeta 3601314 (OJO 'Anexo+DESARROLLO', sin '+de+').
    '2015':
      desarrollo_centros:
        tipo: pdf
        url: https://www.cantabria.es/documents/16870/3151201/Anexo+de+DESARROLLO+ECON%C3%93MICO+DE+GASTO+POR+CENTROS+GESTORES.pdf/42efe732-e9b1-476c-b1a2-7e4b55cf3edf?t=1421084127747
