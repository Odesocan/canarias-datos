    # 2026-07-24 · Rework del bloque 313x (servicios sociales, Consejería de
    # Bienestar). Asturias NO desglosa dependencia/discapacidad/salud_mental como
    # programas propios: viven agregados en los programas 313x de servicios
    # sociales. El Cuaderno Metodológico define la procedencia de `dependencia`
    # como "Sección/DG dentro de SS ... SS general en otras CCAA" (Asturias no
    # tiene DG dedicada tipo SEPAD) → el envoltorio de SS general se asigna a
    # DEPENDENCIA (concepto dominante y procedencia metodológica).
    # Antes del fix: el envoltorio caía en salud_mental (313A/313E ≈ 416 M€
    # falsos, por el patrón GLOBAL 313A/313E que codifica el 313A de Madrid) y en
    # discapacidad (313F ATENCIÓN A LA INFANCIA ≈ 51 M€ falsos), mientras
    # dependencia solo recogía 313G/313D (~0,8 → 70 M€, salto espurio en 2024 al
    # aparecer la línea 313G). Ver logs/progreso.md 2026-07-24 y limitaciones-ast.md.
    dependencia:
      # Envoltorio de servicios sociales generales:
      #  313A PRESTACIONES Y PROGRAMAS CONCERTADOS (plazas residenciales/de día
      #       concertadas, prestaciones económicas de dependencia)
      #  313E GESTIÓN DE SERVICIOS SOCIALES (residencias públicas, SAD,
      #       teleasistencia, valoración de la dependencia)
      #  313G AYUDAS DIVERSAS CON FINES SOCIALES (línea nueva desde 2024)
      #  313D PENSIONES NO CONTRIBUTIVAS
      codigos:
      - 313A
      - 313E
      - 313G
      - 313D
      keywords:
      - dependencia
      - atencion a la dependencia
    # discapacidad y salud_mental: NULL ESTRUCTURAL por diseño. No son separables
    # del envoltorio 313x (comparten DG con dependencia — Cuaderno: "Misma DG que
    # dependencia en muchas CCAA"; Asturias no tiene programa propio de salud
    # mental). Se retiran las asignaciones erróneas previas (313F infancia→
    # discapacidad, 312A inexistente→salud_mental). Residual conocido: 313C
    # COOPERACIÓN AL DESARROLLO (~6,7 M€/año) sigue cayendo en discapacidad vía el
    # patrón GLOBAL 313C (compartido con Galicia); no se anula aquí para no
    # alterar gal. Igual patrón residual: 313B EMIGRACIÓN→diversidad (global).
    turismo:
      codigos:
      - 432A
      keywords:
      - turismo
    igualdad:
      codigos:
      - 323A
      keywords:
      - igualdad
